# Raspberry Pi API
PORT=5060
COCOWHEELS_DB_PATH=/home/jmos0905/cocowheels/data/cocowheels.db
COCOWHEELS_FRONTEND_ORIGIN=http://localhost:3000
COCOWHEELS_PUBLIC_ORIGIN=http://localhost:3000

# Server-side only. Never prefix this value with NEXT_PUBLIC_.
COCOWHEELS_API_PROXY_TARGET=http://localhost:5060

# Required for production code recovery after a rider refresh. Generate with:
# openssl rand -base64 32
COCOWHEELS_CODE_ENCRYPTION_KEY=

# Optional nearby-place labels for confirmed map pins. Server-side only.
COCOWHEELS_GEOAPIFY_KEY=
