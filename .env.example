# Raspberry Pi API. Keep the real .env private and do not commit it.
PORT=5060
COCOWHEELS_DB_PATH=/home/jmos0905/COCOWHEEL/data/cocowheels.db

# Comma-separated browser origins allowed to use the Pi API. Vercel's
# same-origin proxy preserves the frontend Origin when it calls the tunnel.
COCOWHEELS_FRONTEND_ORIGINS=https://your-frontend.example
COCOWHEELS_PUBLIC_ORIGIN=https://your-frontend.example

# This is set only in Vercel's server-side environment after the dedicated
# Cocowheels tunnel is ready. Never prefix it with NEXT_PUBLIC_.
# COCOWHEELS_API_PROXY_TARGET=https://cocowheels-api.your-domain.example

# Required for production code recovery after a rider refresh. Generate with:
# openssl rand -base64 32
COCOWHEELS_CODE_ENCRYPTION_KEY=

# Optional nearby-place labels for confirmed map pins. Server-side only.
COCOWHEELS_GEOAPIFY_KEY=

# University verification email delivery. API host only, never NEXT_PUBLIC_.
# Configure a verified sender in Resend before enabling real code delivery.
COCOWHEELS_RESEND_API_KEY=
COCOWHEELS_EMAIL_FROM=
